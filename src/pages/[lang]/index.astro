---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Clocks from '../../components/Clocks.astro';
import Showreel from '../../components/Showreel.astro';
import About from '../../components/About.astro';
import ScrollRows from '../../components/ScrollRows.astro';
import Services from '../../components/Services.astro';
import Work from '../../components/Work.astro';
import Testimonials from '../../components/Testimonials.astro';
import LogoTicker from '../../components/LogoTicker.astro';
import News from '../../components/News.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import { getContent, locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const content = getContent(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, `/${l}/`]));
---

<BaseLayout
  locale={locale}
  title={content.site.meta.title}
  description={content.site.meta.description}
  alternates={alternates}
>
  <Header locale={locale} alternates={alternates} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Clocks locale={locale} />
    <Showreel locale={locale} />
    <About locale={locale} />
    <ScrollRows locale={locale} />
    <Services locale={locale} />
    <Work locale={locale} />
    <Testimonials locale={locale}>
      <div class="container"><LogoTicker label={content.testimonials.tickerLabel} /></div>
    </Testimonials>
    <News locale={locale} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
