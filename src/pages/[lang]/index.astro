---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getContent, locales, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const content = getContent(locale);
const alternates = Object.fromEntries(locales.map((l) => [l, `/${l}/`]));
---

<BaseLayout
  locale={locale}
  title={content.site.meta.title}
  description={content.site.meta.description}
  alternates={alternates}
>
  <Header locale={locale} alternates={alternates} />
  <main id="main" tabindex="-1">
    <h1 class="container">{content.site.hero.before} {content.site.hero.after}</h1>
  </main>
</BaseLayout>
