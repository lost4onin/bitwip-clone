---
import '@fontsource-variable/inter-tight';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

import { getContent, localeMeta, locales, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of this page for each locale, e.g. { en: '/en/', fr: '/fr/' }. */
  alternates: Partial<Record<Locale, string>>;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  locale,
  title,
  description,
  alternates,
  image = '/images/og.webp',
  imageAlt,
  type = 'website',
  publishedTime,
} = Astro.props;

const { site } = getContent(locale);
const meta = localeMeta[locale];
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(alternates[locale] ?? Astro.url.pathname, origin).href;
const ogImage = new URL(image, origin).href;
const otherLocales = locales.filter((l) => l !== locale && alternates[l]);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Orbe Studio',
  url: new URL(`/${locale}/`, origin).href,
  logo: new URL('/favicon.svg', origin).href,
  email: site.footer.email,
  address: { '@type': 'PostalAddress', streetAddress: site.footer.address[0], addressLocality: 'Paris', addressCountry: 'FR' },
};
---

<!doctype html>
<html lang={meta.htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      locales
        .filter((l) => alternates[l])
        .map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l]!, origin).href} />)
    }
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, origin).href} />}

    <!-- Open Graph / social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Orbe Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? site.meta.ogImageAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />

    <!-- Apply the saved colour scheme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.skipLink}</a>
    <slot />
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
