---
import { getContent, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  /** Prefix for in-page anchors; empty on the homepage, `/en/` elsewhere. */
  anchorBase?: string;
}

const { locale, anchorBase = '' } = Astro.props;
const { site } = getContent(locale);
const { footer, nav } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact" aria-labelledby="footer-title">
  <div class="container">
    <div class="footer-cta" data-reveal>
      <h2 class="footer-title" id="footer-title">{footer.headline}</h2>
      <a class="btn footer-btn" href={`mailto:${footer.email}`}>
        {footer.cta}
        <svg class="arrow" width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="footer-grid">
      <div>
        <h3 class="footer-label">Email</h3>
        <a class="link footer-email" href={`mailto:${footer.email}`}>{footer.email}</a>
      </div>
      <div>
        <h3 class="footer-label">{footer.addressTitle}</h3>
        <address>
          {footer.address.map((line) => <span>{line}</span>)}
        </address>
      </div>
      <nav aria-label={footer.navLabel}>
        <h3 class="footer-label">Menu</h3>
        <ul role="list">
          {
            nav.items.slice(0, -1).map((item) => (
              <li>
                <a class="link" href={`${anchorBase}${item.href}`}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div>
        <h3 class="footer-label">{footer.socialTitle}</h3>
        <ul role="list">
          {
            footer.social.map((item) => (
              <li>
                <a class="link" href={item.href} rel="noopener" target="_blank">
                  {item.label}
                  <span class="visually-hidden"> {footer.newTab}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="footer-wordmark" aria-hidden="true">orbe<span>.</span></p>

    <div class="footer-bottom">
      <p>© {year} Orbe Studio — {footer.legal}</p>
      <p>{footer.credit}</p>
      <a class="link" href="#main">{footer.backToTop} ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--section-space);
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
  }

  .footer-cta {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 56em) {
    .footer-cta {
      grid-template-columns: 1fr auto;
    }
  }

  .footer-title {
    max-width: 12ch;
    font-size: var(--fs-h2);
  }

  .footer-btn {
    font-size: var(--fs-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56em) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .footer-label {
    margin-bottom: 1rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .footer-email {
    font-size: var(--fs-lg);
    overflow-wrap: anywhere;
  }

  address {
    display: grid;
    font-style: normal;
  }

  .footer-grid ul {
    display: grid;
    gap: 0.4rem;
  }

  /* Oversized wordmark, cropped by the page edge */
  .footer-wordmark {
    font-size: clamp(6rem, 2rem + 22vw, 26rem);
    font-weight: 600;
    line-height: 0.75;
    letter-spacing: -0.07em;
    margin-left: -0.04em;
    color: var(--fg);
    user-select: none;
  }

  .footer-wordmark span {
    color: var(--accent-text);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
</style>
