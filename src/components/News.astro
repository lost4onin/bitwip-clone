---
import { formatDate, getContent, getNews, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { news } = getContent(locale);
const articles = (await getNews(locale)).slice(0, 3);
---

<section class="section news" id="news" aria-labelledby="news-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{news.label}</p>
      <h2 class="h2" id="news-title" data-reveal>{news.title}</h2>
    </div>

    <ul class="news-grid" role="list">
      {
        articles.map((article, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <article class="news-card">
              <div class="news-media">
                <img
                  src={article.data.image}
                  alt={article.data.alt}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="news-meta">
                <span class="tag">{article.data.category}</span>
                <time datetime={article.data.date.toISOString().slice(0, 10)}>{formatDate(article.data.date, locale)}</time>
              </p>
              <h3 class="news-title">
                {/* The stretched link makes the whole card clickable. */}
                <a href={`/${locale}/news/${article.slug}/`}>{article.data.title}</a>
              </h3>
              <p class="news-excerpt">{article.data.excerpt}</p>
              <span class="news-more" aria-hidden="true">
                {news.readMore}
                <svg width="14" height="14" viewBox="0 0 16 16">
                  <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .news-grid {
    display: grid;
    gap: clamp(2.5rem, 4vw, 2rem);
  }

  @media (min-width: 48em) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
  }

  .news-media {
    order: -1;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 3 / 2;
    background: var(--bg-elev);
    margin-bottom: 0.4rem;
  }

  .news-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .news-card:hover .news-media img {
    transform: scale(1.05);
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
  }

  .tag {
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .news-title {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .news-title a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--dur) var(--ease-out);
  }

  .news-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .news-title a:focus-visible {
    outline: none;
  }

  .news-title a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  .news-card:hover .news-title a {
    background-size: 100% 1px;
  }

  .news-excerpt {
    color: var(--fg-muted);
  }

  .news-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--accent-text);
  }

  .news-more svg {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .news-card:hover .news-more svg {
    transform: translateX(4px);
  }
</style>
