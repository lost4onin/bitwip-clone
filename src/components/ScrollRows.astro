---
import { getContent, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { services, work, about } = getContent(locale);

// Each row repeats its content so it always overflows the viewport while it slides.
const disciplines = services.items.map((s) => s.title);
const industries = Object.values(work.industries);
const images = [
  ...work.projects.map((p) => ({ src: p.image, width: 1200, height: 900 })),
  ...about.gallery.map((g) => ({ src: g.src, width: g.width, height: g.height })),
];
const repeat = <T,>(items: T[], times: number): T[] => Array.from({ length: times }, () => items).flat();
---

<!-- Decorative: every word and image here also appears elsewhere on the page. -->
<div class="rows" data-scroll aria-hidden="true">
  <div class="row row--text row--left">
    {
      repeat(disciplines, 3).map((word) => (
        <span class="row-word">
          {word}
          <span class="row-dot" />
        </span>
      ))
    }
  </div>

  <div class="row row--media row--right">
    {
      repeat(images, 2).map((img, i) => (
        <span class:list={['row-frame', i % 3 === 1 && 'row-frame--pill', i % 3 === 2 && 'row-frame--square']}>
          <img src={img.src} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />
        </span>
      ))
    }
  </div>

  <div class="row row--text row--outline row--left">
    {
      repeat(industries, 3).map((word) => (
        <span class="row-word">
          <em class="serif">{word}</em>
          <span class="row-dot" />
        </span>
      ))
    }
  </div>
</div>

<style>
  .rows {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    contain: paint;
  }

  .row {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(1rem, 2.5vw, 2rem);
    white-space: nowrap;
  }

  /* ---------- Type rows ---------- */
  .row--text {
    font-size: clamp(3.5rem, 1rem + 9vw, 10rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .row-word {
    display: inline-flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .row-dot {
    width: 0.22em;
    height: 0.22em;
    border-radius: 50%;
    background: var(--accent);
  }

  .row--outline .serif {
    font-size: 1.08em;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--fg-muted);
  }

  /* ---------- Image row ---------- */
  .row-frame {
    flex: none;
    height: clamp(9rem, 4rem + 14vw, 18rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-elev);
  }

  .row-frame--pill {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-pill);
  }

  .row-frame--square {
    aspect-ratio: 1;
  }

  .row-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Scroll-linked motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .row {
      will-change: translate;
    }

    /* Rows travel 60vw over the time the band crosses the viewport,
       in opposite directions, so scrolling reads as sideways motion. */
    :global(.js) .row--left {
      translate: calc(var(--progress, 0) * -60vw) 0;
    }

    :global(.js) .row--right {
      translate: calc(-60vw + var(--progress, 0) * 60vw) 0;
    }

    /* Each picture zooms out while its row slides. */
    :global(.js) .row-frame img {
      scale: calc(1.3 - var(--progress, 0) * 0.3);
    }
  }
</style>
